# Sem API_BASE_URL: demonstracao local com dados ficticios.
# Com API_BASE_URL: API real, sem fallback para dados de demonstracao.
# URL inclui /api se sua API utilizar esse prefixo. HTTPS obrigatorio.
API_BASE_URL=
# Token opcional, enviado somente pelo servidor ao backend.
API_TOKEN=
# Protecao de acesso obrigatoria no modo API real.
# Defina ambos no Vercel. Nao use os valores de exemplo como senha.
PORTAL_USER=
PORTAL_PASSWORD=
